ces", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_vertical_slicing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_sentinel_error_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_context_propagation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_repository_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_single_binary_cli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_testing_strategy", "relation": "ref