{"nodes": [{"id": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "label": "GoBase Go Project Template Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_gobase", "label": "GoBase template", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batteries-included Go project template inspired by Laravel's artisan: one binary with subcommands (serve, migrate, jwt), chi HTTP API, sqlx DB access, golang-migrate, HMAC JWT, slog. Clone, run ./setup.sh, start building."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_chi", "label": "chi HTTP router", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for net/http compatibility, clean route groups, and the whole stdlib ecosystem."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_cobra", "label": "cobra CLI framework", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Industry standard, subcommand nesting, built-in help."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_sqlx", "label": "sqlx database layer", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw SQL with struct scanning, minimal magic."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_golang_migrate", "label": "golang-migrate migrations", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SQL-file-based migrations with CLI integration and no ORM coupling; files embedded via //go:embed so the binary is self-contained."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_hmac_jwt_auth", "label": "HMAC-SHA256 JWT authentication", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simple shared secret, stateless verification; ParseToken validates signature AND expiry; middleware injects Claims into request context."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_slog", "label": "slog structured logging", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stdlib structured logging; JSON format in production, text format in development."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_go_playground_validator", "label": "go-playground/validator", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Struct-tag validation, standard in Go."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_config_management", "label": "Config management (env + .env)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard 12-factor pattern; loading order flags > environment variables > .env file; .env is ignored in production."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_setup_sh", "label": "setup.sh bootstrap script", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interactive bootstrap: prompts for new module path, replaces github.com/wesleysnt/gobase across all .go files and go.mod, copies .env.example to .env, runs go mod tidy."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_server_infrastructure", "label": "HTTP server infrastructure", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "internal/server owns chi router assembly (RequestID, request logging, recovery), graceful shutdown on SIGINT/SIGTERM with 30s drain deadline, JSON response helpers, and http.Server timeouts."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_user_domain_module", "label": "user domain module (reference slice)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fully working CRUD domain (model, handler, service, repository) that serves both as a usable user-management starting point and the reference pattern for adding new domains; keep it or delete it, either way it shows the conventions."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_internal_package_boundary", "label": "Go internal/ package boundary", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents code outside the module from importing app packages; the Go equivalent of 'you don't know it's a library until you need it to be one'."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_vertical_slicing", "label": "Vertical slicing by feature", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each domain is a flat folder under internal/ containing all layers (model, handler, service, repository); adding a domain means one new folder, removing one means rm -rf internal/<domain>/. Infrastructure shared across domains stays as shared packages."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_sentinel_error_mapping", "label": "Sentinel error mapping", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Services define and return sentinel errors (ErrNotFound, ErrValidation, ErrConflict, ErrForbidden, ErrUnauthorized); server.codeFrom maps them with errors.Is to 404/422/409/403/401; unknown errors default to 500 and are logged at ERROR level."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_context_propagation", "label": "context.Context propagation convention", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every stack layer (handler > service > repository) passes context.Context as the first argument for cancellation/deadline propagation; no global request state."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_repository_pattern", "label": "Repository pattern", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concrete structs (not interfaces by default) with sqlx for scanning; all SQL lives in repository methods and the service layer never constructs SQL. Use interfaces where testing requires stubs."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_single_binary_cli", "label": "Single binary with subcommands", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main.go calls cmd.Execute(); the HTTP server is just another subcommand (serve), mirroring Laravel artisan; running gobase with no args prints help."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_testing_strategy", "label": "Testing strategy", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Table-driven unit tests with no mocking framework (interfaces where stubs are required, concrete types where not); integration tests run against a real DB via TEST_DATABASE_URL with migrations in setup; handler tests use the real chi router and middleware; shared helpers in internal/testutil."}, {"id": "docs_superpowers_specs_2026_07_30_gobase_design_di_no_global_state", "label": "No global state / dependency injection", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No global state; dependencies injected through constructors and function parameters so layers are testable in isolation."}], "edges": [{"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_gobase", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_chi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_cobra", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_sqlx", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_golang_migrate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_hmac_jwt_auth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-30-gobase-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_30_gobase_design_doc", "target": "docs_superpowers_specs_2026_07_30_gobase_design_slog", "relation": "references", "c